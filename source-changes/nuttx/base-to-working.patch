+    cfg.sd_prescale = 0,                                      \
+    cfg.sd_scale = I2S_PDM_SIG_SCALING_MUL_1,                 \
+    cfg.hp_scale = I2S_PDM_SIG_SCALING_DIV_2,                 \
+    cfg.lp_scale = I2S_PDM_SIG_SCALING_MUL_1,                 \
+    cfg.sinc_scale = I2S_PDM_SIG_SCALING_MUL_1,               \
