+config ESPRESSIF_FLASH_FREQ_20M
+	bool "20 MHz"
+	depends on ARCH_CHIP_ESP32C3 || ARCH_CHIP_ESP32C6 || ARCH_CHIP_ESP32P4
+
+endchoice # ESPRESSIF_FLASH_FREQ
