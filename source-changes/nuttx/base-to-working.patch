index 00000000000..f70006660b6
--- /dev/null
+++ b/arch/risc-v/src/esp32p4/espressif/esp_ws2812.c
@@ -0,0 +1,686 @@
+/****************************************************************************
+ * arch/risc-v/src/esp32p4/espressif/esp_ws2812.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Licensed to the Apache Software Foundation (ASF) under one or more
