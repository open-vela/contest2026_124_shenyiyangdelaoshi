+++ b/boards/risc-v/esp32p4/esp32p4-function-ev-board/src/esp32p4_sdmmc.c
@@ -0,0 +1,291 @@
+/****************************************************************************
+ * boards/risc-v/esp32p4/esp32p4-function-ev-board/src/esp32p4_sdmmc.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
