+  .rxavailable   = esp_rxavailable,
+  .txready       = esp_txready,
+  .txempty       = esp_txempty,
+  .send          = esp_send,
+  .receive       = esp_receive,
+  .ioctl         = esp_ioctl,
+#ifdef CONFIG_SERIAL_IFLOWCONTROL
+  .rxflowcontrol = esp_rxflowcontrol
+#endif
+};
