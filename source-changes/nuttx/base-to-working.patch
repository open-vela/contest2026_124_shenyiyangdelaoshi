@@ -0,0 +1,399 @@
+/****************************************************************************
+ * arch/risc-v/src/esp32p4/espressif/esp_lirc.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Licensed to the Apache Software Foundation (ASF) under one or more
