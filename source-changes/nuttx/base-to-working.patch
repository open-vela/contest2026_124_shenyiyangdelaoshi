+  list(APPEND SRCS esp_rmt.c)
+  if(CONFIG_DRIVERS_RC)
+    list(APPEND SRCS esp_lirc.c)
+  endif()
+  if(CONFIG_WS2812_NON_SPI_DRIVER)
+    list(APPEND SRCS esp_ws2812.c)
+  endif()
+endif()
+
+if(CONFIG_ESP_SDM)
+  list(APPEND SRCS esp_sdm.c)
+endif()
+
