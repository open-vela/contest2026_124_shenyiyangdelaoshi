index 00000000000..98ee2a6c255
--- /dev/null
+++ b/arch/risc-v/src/esp32p4/espressif/esp_dedic_gpio.c
@@ -0,0 +1,440 @@
+/****************************************************************************
+ * arch/risc-v/src/esp32p4/espressif/esp_dedic_gpio.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Licensed to the Apache Software Foundation (ASF) under one or more
