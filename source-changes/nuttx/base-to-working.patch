--- /dev/null
+++ b/arch/risc-v/src/esp32p4/espressif/esp_mipi_dsi.c
@@ -0,0 +1,557 @@
+/****************************************************************************
+ * arch/risc-v/src/esp32p4/espressif/esp_mipi_dsi.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Licensed to the Apache Software Foundation (ASF) under one or more
