+/****************************************************************************
+ * Name: esp_pcnt_unit_start
+ *
+ * Description:
+ *   Start PCNT unit for counting.
+ *
+ * Input Parameters:
+ *   dev - Pointer to the pcnt driver struct
+ *
+ * Returned Value:
+ *   OK on success; ERROR on failure
+ *
+ ****************************************************************************/
+
+static int esp_pcnt_unit_start(struct cap_lowerhalf_s *dev)
+{
