+};
+
+static const struct v4l2_frmivalenum g_sc2336_frmintervals[] =
+{
+  {
+    .index        = 0,
+    .buf_type     = V4L2_BUF_TYPE_VIDEO_CAPTURE,
+    .pixel_format = V4L2_PIX_FMT_RGB565,
