+
+#define I2S_TDM_PHILIPS_SLOT_DEFAULT_CONFIG(cfg, bits_per_sample, mask) \
+    cfg.slot_mask = (mask),                                             \
+    cfg.ws_width = I2S_TDM_AUTO_WS_WIDTH,                               \
+    cfg.ws_pol = false,                                                 \
+    cfg.bit_shift = true,                                               \
