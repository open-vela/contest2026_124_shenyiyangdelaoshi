+#include <nuttx/config.h>
+
+#include <arch/irq.h>
+
+#include "riscv_internal.h"
+#include "chip.h"
+
+/****************************************************************************
+ * Public Symbols
+ ****************************************************************************/
+
+  .global  __start
+
+/****************************************************************************
+ * Section: .text
+ ****************************************************************************/
+
+  .section .text
+
+/****************************************************************************
+ * Name: __start
+ ****************************************************************************/
+
+__start:
+
+  .option push
+  .option norelax
+
+  /* Set stack pointer to the idle thread stack */
+
+  la   sp, _ebss
+  li   t0, SMP_STACK_SIZE
+  add  sp, sp, t0
+
+  /* Set gp pointer */
+
+  la   gp, __global_pointer$
+
+  /* Disable all interrupts (i.e. timer, external) in mstatus */
+
+  csrc CSR_STATUS, STATUS_IE
+
+  .option pop
+
+  /* Jump to __esp_start */
+
+  jal  x1, __esp_start
+
+  /* We shouldn't return from __esp_start */
+
+  ret
